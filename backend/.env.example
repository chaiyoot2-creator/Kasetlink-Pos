# Copy to /etc/kasetlink-pos/api.env on the VPS (setup-vps.sh writes it for you).
DATABASE_URL=postgres://pos:CHANGE_ME@127.0.0.1:5432/kasetlink_pos
PORT=3001
HOST=127.0.0.1
# Public URL of this API (used for product image links), e.g. https://api.yourshop.com
PUBLIC_API_URL=https://api.example.com
# Vercel URL(s) of the web app, comma separated (custom domain + *.vercel.app if used)
CORS_ORIGINS=https://pos.example.com,https://kasetlink-pos.vercel.app
UPLOAD_DIR=/var/lib/kasetlink-pos/uploads
# Google Drive backup (rclone remote:folder); empty = keep dumps on the VPS only
RCLONE_REMOTE=gdrive:KasetLink-POS-Backup
BACKUP_DIR=/var/backups/kasetlink-pos
BACKUP_KEEP_DAYS=30
# APP_STAGE=dev shows the "test mode" banner
